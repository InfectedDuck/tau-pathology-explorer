# Dev (Vite reads this at `npm run dev` / build time). Frontend works without it.
VITE_API_URL=http://localhost:8000

# Production (Docker image): VITE_API_URL is baked at build time, but the
# container entrypoint regenerates /env.js on every start, so you can override
# without rebuilding:
#   docker run -p 8080:80 -e VITE_API_URL=http://api:8000 tau-explorer
